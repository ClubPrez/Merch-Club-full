# SAGE Connect — Product Search proxy (serviceId 103, apiVer 130)
# Set these as Replit Secrets (development) and as Vercel Environment Variables (production).
# These values are server-only and must never be exposed to the client.

# Full SAGE Connect endpoint URL the proxy POSTs to.
SAGE_CONNECT_URL=

# SAGE account ID (numeric).
SAGE_ACCT_ID=

# SAGE Connect login ID.
SAGE_LOGIN_ID=

# SAGE Connect authentication key.
SAGE_AUTH_KEY=
