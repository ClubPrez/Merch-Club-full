{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/merch-club build",
  "outputDirectory": "artifacts/merch-club/dist/public",
  "framework": null,
  "routes": [
    { "src": "/home/?", "headers": { "Location": "/" }, "status": 301 },
    { "src": "/contact/", "headers": { "Location": "/contact" }, "status": 301 },
    { "src": "/gallery/?", "headers": { "Location": "/case-studies" }, "status": 301 },
    { "src": "/latest-catalogs/?", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/nailheads-print-tshirt/feed/?$", "dest": "/404.html", "status": 410 },
    { "src": "/product/tackle-knit/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/nfc-tap-tee/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/sublimated-patches/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/chromaflex-holographic/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/chromaflex-beveled/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/chromaflex-flat/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/chromaflex/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/applique/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/seam-spray/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/pms-color-match/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product/lextra-3d-4d/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "src": "/product-category/custom-shirts/?$", "headers": { "Location": "/services" }, "status": 301 },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/404.html", "status": 404 }
  ]
}
